# Hydro experiment runtime/generated artifacts
Hydro/experiments/**/batch_outputs/
Hydro/experiments/**/physics_outputs/
Hydro/experiments/**/sweep_runs/
Hydro/experiments/**/generated_sweep/
Hydro/experiments/**/generated_stage2/
Hydro/experiments/**/generated_stage3/
Hydro/experiments/**/generated_unified/
Hydro/experiments/**/batch_summary*.csv
Hydro/experiments/**/*_summary.csv
Hydro/experiments/**/hyperparameter_stage*.batch
Hydro/experiments/**/gistohq_unified_sweep.batch
Hydro/experiments/**/unified_sweep.batch

# Directly exported experiment folders and archived reruns
Hydro/experiments/**/sligo_*/
Hydro/experiments/**/unified_*/

# Transient per-worker shard batch files written by parallel_run_generated()
# in run_improved_adaptive_pipeline.py; normally self-deleted, but can be
# left behind if a run is interrupted.
Hydro/experiments/**/.unified_sweep.parallel_*.batch

# Python bytecode cache (the Hydro experiment/paper scripts are Python)
__pycache__/
*.pyc

# HydroBatch build output directories (qmake-generated; never source)
build-hydrobatch/
build-hydrobatch-dev/

# Ad-hoc scratch batch files dropped at the repo root during manual testing;
# real batch files live under Hydro/experiments/**/*.batch, never at the root.
/*.batch

# Ad-hoc scratch sweep/smoke-test directories (leading underscore is this
# project's convention for throwaway manual runs, e.g. _bias_test/,
# _residual_sweep/, _ensemble/) - normally deleted once their results are
# copied out, but ignored too in case one is left behind.
Hydro/experiments/**/_*/

# Ad-hoc scratch directories dropped at the repo root during manual batch
# generation/testing (e.g. .scratch_lstm_comparison/, .scratch_decision_gate_b/,
# .scratch_gate_b_smoke/) - config/batch files generated for a HydroBatch run,
# with real results copied out to Dropbox afterward. Same throwaway intent as
# the underscore convention above, just at the repo root instead of under
# Hydro/experiments/.
/.scratch_*/

